parts = DATA.split("\n@@LDA_STAGE@@\n")
entries = [
{% for t in languages %}
{% if strategy.renderer_binding == "callable" %}
    ("{{ t.id }}", parts[{{ positions[t.id] }}], RENDERERS["{{ t.renderer }}"]),
{% else %}
    ("{{ t.id }}", parts[{{ positions[t.id] }}], "{{ t.renderer }}"),
{% endif %}
{% endfor %}
]
_, source, renderer = entries[index]
{% if strategy.renderer_binding == "callable" %}
encoded = renderer(DATA)
{% else %}
encoded = RENDERERS[renderer](DATA)
{% endif %}
