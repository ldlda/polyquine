$parts = $DATA.Split("`n@@LDA_STAGE@@`n", [System.StringSplitOptions]::None)
$entries = @(
{% for t in languages %}
{% if strategy.renderer_binding == "callable" %}
    ,@("{{ t.id }}", $parts[{{ positions[t.id] }}], $RENDERERS["{{ t.renderer }}"])
{% else %}
    ,@("{{ t.id }}", $parts[{{ positions[t.id] }}], "{{ t.renderer }}")
{% endif %}
{% endfor %}
)
$id, $source, $renderer = $entries[$index]
{% if strategy.renderer_binding == "callable" %}
$encoded = [string](& $renderer $DATA)
{% else %}
$encoded = [string](& $RENDERERS[$renderer] $DATA)
{% endif %}
