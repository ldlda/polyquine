        entries = [
{% for t in languages %}
{% if strategy.renderer_binding == 'callable' %}
            ("{{ t.id }}", parts !! {{ positions[t.id] }}, render "{{ t.renderer }}"){% if not loop.last %},{% endif %}

{% else %}
